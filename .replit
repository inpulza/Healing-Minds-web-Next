modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["imagemagick"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 5055
externalPort = 3000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.development]
    # BLOG_ADMIN_AUTH_MODE is deliberately NOT set to "off" here. The development
    # preview is served on a public URL, so disabling admin auth would expose
    # /api/contact-messages (patient enquiries) and the blog mutation APIs to anyone
    # who reaches it. Sign in with BLOG_ADMIN_USERNAME / BLOG_ADMIN_PASSWORD instead.
    BLOG_IMAGE_ENABLED = "true"
BLOG_TOPIC_ENABLED = "true"
BLOG_LINK_ENABLED = "true"

[userenv.production]
BLOG_IMAGE_ENABLED = "true"
BLOG_TOPIC_ENABLED = "true"

[objectStorage]
defaultBucketID = "replit-objstore-325fceb0-c446-4815-996f-ca012b98d415"
