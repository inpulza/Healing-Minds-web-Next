{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inpulza.local/native-reconstruction/brief.schema.json",
  "title": "Native Reconstruction brief",
  "type": "object",
  "required": ["schemaVersion", "briefId", "requirements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "briefId": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^BR-[A-Z0-9-]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["must", "should", "could"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
