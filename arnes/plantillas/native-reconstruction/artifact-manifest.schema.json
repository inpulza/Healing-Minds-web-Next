{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inpulza.local/native-reconstruction/artifact-manifest.schema.json",
  "title": "Native Reconstruction frozen artifact manifest",
  "type": "object",
  "required": ["schemaVersion", "manifestId", "pilotId", "createdAt", "frozenBy", "roots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestId": { "type": "string", "minLength": 1 },
    "pilotId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "frozenBy": { "type": "string", "minLength": 1 },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "treeSha256", "files"],
        "properties": {
          "path": { "enum": ["forensics", "audit-baseline"] },
          "treeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "size", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "size": { "type": "integer", "minimum": 0 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
